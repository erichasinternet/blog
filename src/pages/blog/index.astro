---
import BlogPosts from "../../components/posts.astro";
import Base from "../../layouts/base.astro";
---

<Base
  title="Eric's Blog"
  description="This is a collection of my thoughts and ideas."
>
  <div
    class="drop-shadow-2xl flex flex-col items-center justify-center max-w-3xl px-8 mx-auto mt-8 sm:mt-0 sm:px-0"
  >
    <div>
      <div
        class="py-4 text-4xl font-extrabold text-black tracking-tight items-center sm:text-1xl md:text-2xl lg:text-5xl md:-mb-4 flex flex-col gap-3  lg:items-start"
      >
        <h1
          class="text-neutral-900 dark:text-neutral-100 tracking-tight before:block before:absolute before:-inset-1 before:bg-yellow-200 relative"
        >
          <span class="relative dark:text-black">Posts:</span>
        </h1>
        <div class="mt-8 relative text-xl sm:text-xl md:text-2xl lg:text-3xl">
          <BlogPosts />
        </div>
      </div>
    </div>
  </div>
</Base>
