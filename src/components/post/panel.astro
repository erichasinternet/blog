---
interface Props {
  src: string;
  alt: string;
  label?: string;
  pixelated?: string;
  top?: string;
  bottom?: string;
}

const { src, alt, label, pixelated, top, bottom } = Astro.props;
---

<figure>
  <div class="panel-wrap">
    <img
      src={src}
      alt={alt}
      loading="lazy"
      style={pixelated ? { imageRendering: "pixelated" } : undefined}
    />
    {top ? <span class="panel-tag top">{top}</span> : null}
    {bottom ? <span class="panel-tag bottom">{bottom}</span> : null}
  </div>
  {label ? <figcaption>{label}</figcaption> : null}
</figure>
